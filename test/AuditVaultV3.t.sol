// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "forge-std/Test.sol";
import {AuditVaultV3} from "../contracts/v3/AuditVaultV3.sol";
import {SignatureChecker} from "../lib/openzeppelin-contracts/contracts/utils/cryptography/SignatureChecker.sol";
import {MockERC8004IdentityRegistry} from "./mocks/MockERC8004IdentityRegistry.sol";
import {
    ERC1271Wallet,
    ERC1271WrongMagic,
    ERC1271DirtyReturn,
    ERC1271Reverting,
    Delegate7702NoErc1271,
    Delegate7702Erc1271
} from "./mocks/V3SignerMocks.sol";

/// @notice Unit tests for AuditVault v3 (docs/design/AUDITVAULT_V3.md §12) against a mock ERC-8004
///         IdentityRegistry. The RFC 6962 and EIP-712 vectors come from fixtures/auditvault-v3/v1/, which
///         were generated by independent Python (hashlib) and ethers implementations.
///         Fork tests against the real registry on Base and Celo are a later step.
contract AuditVaultV3Test is Test {
    // ─── Constants ───

    string constant ARTIFACT = "out/AuditVaultV3.sol/AuditVaultV3.json";
    string constant RFC6962 = "fixtures/auditvault-v3/v1/rfc6962.json";
    string constant EIP712_FIXTURE = "fixtures/auditvault-v3/v1/eip712.json";

    // Design doc §3.1 / §3.2 constants (also recomputed by ethers in eip712.json).
    bytes32 constant BATCH_TYPEHASH = 0x7af2df7acacc5c264ef34182889651ddef0bcf2c042e0c9e022524e49e37cbdf;
    bytes32 constant DOMAIN_TYPEHASH = 0x8b73c3c69bb8fe3d512ecc4cf759cc79239f7b179b0ffacaa9a75d522b39400f;
    bytes32 constant NAME_HASH = 0x63d42055ddacfa97712da5aaf9c6f50377d900c1f922dbf1ebb622c5cc1937d8;
    bytes32 constant VERSION_HASH = 0x2a80e1ef1d7842f27f2e6be0972bb708b9a135c38860dbe73c27c3486c34f4de;
    uint256 constant SECP256K1_N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141;
    address constant CANONICAL_REGISTRY = 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432;

    // ─── Actors ───

    address owner;
    uint256 ownerKey;
    address wallet;
    uint256 walletKey;
    address stranger;
    uint256 strangerKey;
    address operator;
    uint256 operatorKey;
    address approved;
    uint256 approvedKey;
    address newOwner;
    uint256 newOwnerKey;
    address relayer = makeAddr("relayer");

    MockERC8004IdentityRegistry registry;
    AuditVaultV3 vault;
    uint256 agentId;

    function setUp() public {
        (owner, ownerKey) = makeAddrAndKey("owner");
        (wallet, walletKey) = makeAddrAndKey("wallet");
        (stranger, strangerKey) = makeAddrAndKey("stranger");
        (operator, operatorKey) = makeAddrAndKey("operator");
        (approved, approvedKey) = makeAddrAndKey("approved");
        (newOwner, newOwnerKey) = makeAddrAndKey("newOwner");

        registry = new MockERC8004IdentityRegistry();
        vault = new AuditVaultV3(address(registry));
        // register() starts the wallet as msg.sender, so the owner is the signer until a wallet is set.
        vm.prank(owner);
        agentId = registry.register();
    }

    // ─── Helpers ───

    function _batch(uint256 id, uint64 seq, bytes32 prev) internal view returns (AuditVaultV3.Batch memory b) {
        b = AuditVaultV3.Batch({
            identityRegistry: address(registry),
            agentId: id,
            seq: seq,
            prevBatchHash: prev,
            root: keccak256(abi.encode("root", id, seq)),
            leafCount: 4,
            rootFormat: 0,
            metaHash: keccak256(abi.encode("meta", id, seq))
        });
    }

    /// @dev The next valid batch for `id` according to the vault's current state.
    function _next(uint256 id) internal view returns (AuditVaultV3.Batch memory) {
        uint64 seq = vault.nextSeq(id);
        bytes32 prev = seq == 0 ? bytes32(0) : vault.batchHashAt(id, seq - 1);
        return _batch(id, seq, prev);
    }

    function _gap(uint256 id, uint256 reasonCode) internal view returns (AuditVaultV3.Batch memory b) {
        b = _next(id);
        b.root = bytes32(0);
        b.leafCount = 0;
        b.rootFormat = 0;
        b.metaHash = bytes32(reasonCode);
    }

    function _signDigest(uint256 key, bytes32 digest) internal pure returns (bytes memory) {
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(key, digest);
        return abi.encodePacked(r, s, v);
    }

    function _sign(uint256 key, AuditVaultV3.Batch memory b) internal view returns (bytes memory) {
        return _signDigest(key, vault.hashBatch(b));
    }

    function _commit(uint256 key, AuditVaultV3.Batch memory b) internal returns (bytes32) {
        return vault.commitBatch(b, _sign(key, b), "ipfs://batch");
    }

    /// @dev Sets the agent wallet through the registry, with `walletSigKey` signing AgentWalletSet.
    function _setWallet(uint256 id, address newWallet, uint256 walletSigKey) internal {
        address o = registry.ownerOf(id);
        uint256 deadline = block.timestamp + 60;
        bytes memory sig = _signDigest(walletSigKey, registry.agentWalletSetDigest(id, newWallet, o, deadline));
        vm.prank(o);
        registry.setAgentWallet(id, newWallet, deadline, sig);
    }

    /// @dev Forces `getAgentWallet(id)` to return `w`, for signer contracts the registry would never accept.
    function _mockWallet(uint256 id, address w) internal {
        vm.mockCall(address(registry), abi.encodeCall(registry.getAgentWallet, (id)), abi.encode(w));
    }

    function _expectInvalidSignature(address expectedSigner) internal {
        vm.expectRevert(abi.encodeWithSelector(AuditVaultV3.InvalidSignature.selector, expectedSigner));
    }

    function _structHash(AuditVaultV3.Batch memory b) internal pure returns (bytes32) {
        return keccak256(
            abi.encode(
                BATCH_TYPEHASH,
                b.identityRegistry,
                b.agentId,
                b.seq,
                b.prevBatchHash,
                b.root,
                b.leafCount,
                b.rootFormat,
                b.metaHash
            )
        );
    }

    function _digest(AuditVaultV3.Batch memory b, uint256 chainId, address verifyingContract)
        internal
        pure
        returns (bytes32)
    {
        bytes32 ds = keccak256(abi.encode(DOMAIN_TYPEHASH, NAME_HASH, VERSION_HASH, chainId, verifyingContract));
        return keccak256(abi.encodePacked(hex"1901", ds, _structHash(b)));
    }

    function _contains(bytes memory haystack, bytes memory needle) internal pure returns (bool) {
        if (needle.length > haystack.length) return false;
        for (uint256 i = 0; i + needle.length <= haystack.length; ++i) {
            bool ok = true;
            for (uint256 j = 0; j < needle.length; ++j) {
                if (haystack[i + j] != needle[j]) {
                    ok = false;
                    break;
                }
            }
            if (ok) return true;
        }
        return false;
    }

    // ─── Toolchain ───

    function test_deploy_succeeds() public view {
        assertGt(address(vault).code.length, 0);
        assertEq(vault.IDENTITY_REGISTRY(), address(registry));
    }

    function test_constructor_revertsIfRegistryHasNoCode() public {
        vm.expectRevert(abi.encodeWithSelector(AuditVaultV3.RegistryNotContract.selector, address(0)));
        new AuditVaultV3(address(0));
        address eoa = makeAddr("notARegistry");
        vm.expectRevert(abi.encodeWithSelector(AuditVaultV3.RegistryNotContract.selector, eoa));
        new AuditVaultV3(eoa);
    }

    function test_artifact_compiledWithSolc0838() public view {
        string memory json = vm.readFile(ARTIFACT);
        string memory version = vm.parseJsonString(json, ".metadata.compiler.version");
        assertEq(version, "0.8.38+commit.1835d247");
    }

    function test_artifact_targetsPrague() public view {
        string memory json = vm.readFile(ARTIFACT);
        assertEq(vm.parseJsonString(json, ".metadata.settings.evmVersion"), "prague");
        assertTrue(vm.parseJsonBool(json, ".metadata.settings.viaIR"));
        assertEq(vm.parseJsonUint(json, ".metadata.settings.optimizer.runs"), 200);
    }

    // ─── Happy path ───

    function test_commitBatch_genesis() public {
        AuditVaultV3.Batch memory b = _batch(agentId, 0, bytes32(0));
        bytes32 h = _commit(ownerKey, b);
        assertEq(h, vault.hashBatch(b));
        assertEq(vault.nextSeq(agentId), 1);
        assertEq(vault.batchHashAt(agentId, 0), h);
    }

    function test_commitBatch_chainOfThree() public {
        bytes32 h0 = _commit(ownerKey, _batch(agentId, 0, bytes32(0)));
        bytes32 h1 = _commit(ownerKey, _batch(agentId, 1, h0));
        bytes32 h2 = _commit(ownerKey, _batch(agentId, 2, h1));
        assertEq(vault.nextSeq(agentId), 3);
        assertEq(vault.batchHashAt(agentId, 0), h0);
        assertEq(vault.batchHashAt(agentId, 1), h1);
        assertEq(vault.batchHashAt(agentId, 2), h2);
        assertTrue(h0 != h1 && h1 != h2 && h0 != h2);
    }

    function test_commitBatch_emitsBatchCommitted() public {
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(ownerKey, b);
        bytes32 h = vault.hashBatch(b);
        vm.expectEmit(true, true, true, true, address(vault));
        emit AuditVaultV3.BatchCommitted(
            agentId, 0, h, bytes32(0), b.root, b.leafCount, b.rootFormat, b.metaHash, owner, relayer, "ar://payload"
        );
        vm.prank(relayer);
        vault.commitBatch(b, sig, "ar://payload");
    }

    function test_commitBatch_recordsSignerAndBlock() public {
        vm.roll(12_345_678);
        vm.warp(1_800_000_000);
        bytes32 h = _commit(ownerKey, _next(agentId));
        (address signer, uint64 blockNumber, uint32 timestamp) = vault.batchRecord(h);
        assertEq(signer, owner);
        assertEq(blockNumber, 12_345_678);
        assertEq(timestamp, 1_800_000_000);
    }

    function test_commitBatch_setsBatchHashAt() public {
        assertEq(vault.batchHashAt(agentId, 0), bytes32(0));
        bytes32 h = _commit(ownerKey, _next(agentId));
        assertEq(vault.batchHashAt(agentId, 0), h);
        assertEq(vault.batchHashAt(agentId, 1), bytes32(0));
    }

    function test_commitBatch_anyoneCanRelay() public {
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(ownerKey, b);
        vm.prank(stranger);
        bytes32 h = vault.commitBatch(b, sig, "");
        (address signer,,) = vault.batchRecord(h);
        assertEq(signer, owner); // the relayer is not recorded as signer

        AuditVaultV3.Batch memory b2 = _next(agentId);
        bytes memory sig2 = _sign(ownerKey, b2);
        vm.prank(relayer);
        vault.commitBatch(b2, sig2, "");
        assertEq(vault.nextSeq(agentId), 2);
    }

    function test_batchRecord_zeroForUncommitted() public view {
        (address signer, uint64 blockNumber, uint32 timestamp) = vault.batchRecord(keccak256("nope"));
        assertEq(signer, address(0));
        assertEq(blockNumber, 0);
        assertEq(timestamp, 0);
    }

    // ─── Signer resolution (§2.3) ───

    function test_authorizedSigner_walletThenOwner() public {
        assertEq(vault.authorizedSigner(agentId), owner); // wallet = owner after register()
        _setWallet(agentId, wallet, walletKey);
        assertEq(vault.authorizedSigner(agentId), wallet);
        vm.prank(owner);
        registry.unsetAgentWallet(agentId);
        assertEq(vault.authorizedSigner(agentId), owner);
    }

    function test_authorizedSigner_revertsForUnknownAgent() public {
        vm.expectRevert(abi.encodeWithSelector(AuditVaultV3.UnknownAgent.selector, 999));
        vault.authorizedSigner(999);
    }

    function test_commitBatch_walletSigns() public {
        _setWallet(agentId, wallet, walletKey);
        bytes32 h = _commit(walletKey, _next(agentId));
        (address signer,,) = vault.batchRecord(h);
        assertEq(signer, wallet);
    }

    function test_commitBatch_ownerSignsWhenWalletUnset() public {
        _setWallet(agentId, wallet, walletKey);
        vm.prank(owner);
        registry.unsetAgentWallet(agentId);
        assertEq(registry.getAgentWallet(agentId), address(0));
        bytes32 h = _commit(ownerKey, _next(agentId));
        (address signer,,) = vault.batchRecord(h);
        assertEq(signer, owner);
    }

    function test_commitBatch_revertsIfOwnerSignsWhileWalletSet() public {
        _setWallet(agentId, wallet, walletKey);
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(ownerKey, b);
        _expectInvalidSignature(wallet);
        vault.commitBatch(b, sig, "");
    }

    function test_commitBatch_revertsIfOperatorSigns() public {
        vm.startPrank(owner);
        registry.setApprovalForAll(operator, true);
        registry.unsetAgentWallet(agentId);
        vm.stopPrank();
        assertTrue(registry.isAuthorizedOrOwner(operator, agentId));
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(operatorKey, b);
        _expectInvalidSignature(owner);
        vault.commitBatch(b, sig, "");
    }

    function test_commitBatch_revertsIfApprovedSigns() public {
        vm.startPrank(owner);
        registry.approve(approved, agentId);
        registry.unsetAgentWallet(agentId);
        vm.stopPrank();
        assertTrue(registry.isAuthorizedOrOwner(approved, agentId));
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(approvedKey, b);
        _expectInvalidSignature(owner);
        vault.commitBatch(b, sig, "");
    }

    function test_commitBatch_revertsForUnknownAgent() public {
        AuditVaultV3.Batch memory b = _batch(999, 0, bytes32(0));
        bytes memory sig = _sign(strangerKey, b);
        vm.expectRevert(abi.encodeWithSelector(AuditVaultV3.UnknownAgent.selector, 999));
        vault.commitBatch(b, sig, "");
    }

    /// @dev Defensive branch: a registry whose ownerOf returns 0 instead of reverting.
    function test_commitBatch_revertsIfRegistryReturnsZeroOwner() public {
        vm.prank(owner);
        registry.unsetAgentWallet(agentId);
        vm.mockCall(address(registry), abi.encodeCall(registry.ownerOf, (agentId)), abi.encode(address(0)));
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(ownerKey, b);
        vm.expectRevert(abi.encodeWithSelector(AuditVaultV3.UnknownAgent.selector, agentId));
        vault.commitBatch(b, sig, "");
    }

    // ─── Signature rule (§2.4) ───

    function test_commitBatch_erc1271WalletSigns() public {
        (address inner, uint256 innerKey) = makeAddrAndKey("inner");
        ERC1271Wallet sc = new ERC1271Wallet(inner);
        _setWallet(agentId, address(sc), innerKey); // registry accepts it via ERC-1271
        bytes32 h = _commit(innerKey, _next(agentId));
        (address signer,,) = vault.batchRecord(h);
        assertEq(signer, address(sc));
    }

    function test_commitBatch_revertsIfErc1271WalletRejects() public {
        (address inner, uint256 innerKey) = makeAddrAndKey("inner");
        ERC1271Wallet sc = new ERC1271Wallet(inner);
        _setWallet(agentId, address(sc), innerKey);
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(strangerKey, b);
        _expectInvalidSignature(address(sc));
        vault.commitBatch(b, sig, "");
    }

    function test_commitBatch_7702DelegatedEoaEcdsaAccepted() public {
        (address eoa, uint256 eoaKey) = makeAddrAndKey("delegatedEoa");
        _setWallet(agentId, eoa, eoaKey);
        Delegate7702NoErc1271 delegate = new Delegate7702NoErc1271();
        vm.signAndAttachDelegation(address(delegate), eoaKey);
        assertEq(Delegate7702NoErc1271(eoa).ping(), 1);
        assertEq(eoa.code, abi.encodePacked(hex"ef0100", address(delegate)));

        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(eoaKey, b);
        // OZ v5.7.0 isValidSignatureNow sends a delegated EOA to ERC-1271 only and would reject this (§2.4).
        assertFalse(SignatureChecker.isValidSignatureNow(eoa, vault.hashBatch(b), sig));
        bytes32 h = vault.commitBatch(b, sig, "");
        (address signer,,) = vault.batchRecord(h);
        assertEq(signer, eoa);
    }

    function test_commitBatch_7702DelegatedEoaErc1271Accepted() public {
        (address eoa, uint256 eoaKey) = makeAddrAndKey("delegatedEoa");
        (address session, uint256 sessionKey) = makeAddrAndKey("sessionKey");
        _setWallet(agentId, eoa, eoaKey);
        Delegate7702Erc1271 delegate = new Delegate7702Erc1271(session);
        vm.signAndAttachDelegation(address(delegate), eoaKey);
        assertEq(Delegate7702Erc1271(eoa).sessionKey(), session);

        bytes32 h = _commit(sessionKey, _next(agentId)); // not the EOA's own key: ERC-1271 path
        (address signer,,) = vault.batchRecord(h);
        assertEq(signer, eoa);
    }

    function test_commitBatch_revertsOnErc1271WrongMagic() public {
        address sc = address(new ERC1271WrongMagic());
        _mockWallet(agentId, sc);
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(ownerKey, b);
        _expectInvalidSignature(sc);
        vault.commitBatch(b, sig, "");
    }

    function test_commitBatch_revertsOnErc1271DirtyReturn() public {
        address sc = address(new ERC1271DirtyReturn());
        _mockWallet(agentId, sc);
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(ownerKey, b);
        _expectInvalidSignature(sc);
        vault.commitBatch(b, sig, "");
    }

    function test_commitBatch_revertsWhenErc1271Reverts() public {
        address sc = address(new ERC1271Reverting());
        _mockWallet(agentId, sc);
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(ownerKey, b);
        _expectInvalidSignature(sc);
        vault.commitBatch(b, sig, "");
    }

    function test_commitBatch_revertsOnBadEcdsaFromCodelessSigner() public {
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(strangerKey, b);
        assertEq(owner.code.length, 0);
        _expectInvalidSignature(owner);
        vault.commitBatch(b, sig, "");
    }

    function test_commitBatch_revertsOnBadSignatureLength() public {
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(ownerKey, b);
        bytes memory short = new bytes(64);
        for (uint256 i = 0; i < 64; ++i) {
            short[i] = sig[i];
        }
        _expectInvalidSignature(owner);
        vault.commitBatch(b, short, "");
        _expectInvalidSignature(owner);
        vault.commitBatch(b, "", "");
        _expectInvalidSignature(owner);
        vault.commitBatch(b, abi.encodePacked(sig, bytes1(0x00)), "");
    }

    /// @notice Differential fuzz: v3 accepts a signature exactly when the registry's setAgentWallet rule
    ///         accepts it, for the same signer and digest (§12). The registry side here is the mock's
    ///         reimplementation (`walletSignatureAccepted`); the real registry is checked in fork tests later.
    function test_commitBatch_signatureRuleMatchesRegistry(uint8 signerChoice, uint8 keyChoice, uint8 mangle, uint256 fuzzKey)
        public
    {
        fuzzKey = bound(fuzzKey, 1, SECP256K1_N - 1);
        (address eoa, uint256 eoaKey) = makeAddrAndKey("diffEoa");
        (address inner, uint256 innerKey) = makeAddrAndKey("diffInner");
        (address session, uint256 sessionKey) = makeAddrAndKey("diffSession");

        address signer;
        uint256 c = signerChoice % 7;
        if (c == 0) {
            signer = eoa;
        } else if (c == 1) {
            signer = address(new ERC1271Wallet(inner));
        } else if (c == 2) {
            signer = address(new ERC1271WrongMagic());
        } else if (c == 3) {
            signer = address(new ERC1271DirtyReturn());
        } else if (c == 4) {
            signer = address(new ERC1271Reverting());
        } else if (c == 5) {
            vm.signAndAttachDelegation(address(new Delegate7702NoErc1271()), eoaKey);
            Delegate7702NoErc1271(eoa).ping();
            signer = eoa;
        } else {
            vm.signAndAttachDelegation(address(new Delegate7702Erc1271(session)), eoaKey);
            Delegate7702Erc1271(eoa).sessionKey();
            signer = eoa;
        }
        _mockWallet(agentId, signer);

        uint256[4] memory keys = [eoaKey, innerKey, sessionKey, fuzzKey];
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes32 digest = vault.hashBatch(b);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(keys[keyChoice % 4], digest);
        bytes memory sig;
        uint256 m = mangle % 6;
        if (m == 0) {
            sig = abi.encodePacked(r, s, v);
        } else if (m == 1) {
            sig = abi.encodePacked(r, bytes32(SECP256K1_N - uint256(s)), v == 27 ? uint8(28) : uint8(27)); // high-s twin
        } else if (m == 2) {
            sig = abi.encodePacked(r, s, uint8(v - 27)); // v = 0/1
        } else if (m == 3) {
            sig = abi.encodePacked(r, s); // 64 bytes
        } else if (m == 4) {
            sig = abi.encodePacked(r, s, v, bytes1(0x01)); // 66 bytes
        } else {
            sig = abi.encodePacked(r, bytes32(uint256(s) ^ 1), v); // corrupted s
        }

        bool registryAccepts;
        try registry.walletSignatureAccepted(signer, digest, sig) returns (bool ok) {
            registryAccepts = ok;
        } catch {
            registryAccepts = false; // strict abi.decode reverts on a dirty return: not accepted
        }
        bool vaultAccepts;
        try vault.commitBatch(b, sig, "") {
            vaultAccepts = true;
        } catch (bytes memory err) {
            assertEq(err, abi.encodeWithSelector(AuditVaultV3.InvalidSignature.selector, signer));
        }
        assertEq(vaultAccepts, registryAccepts);
    }

    // ─── Malleability (§8.3) ───

    function test_commitBatch_revertsOnHighS() public {
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes32 digest = vault.hashBatch(b);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(ownerKey, digest);
        bytes32 highS = bytes32(SECP256K1_N - uint256(s));
        uint8 flippedV = v == 27 ? uint8(28) : uint8(27);
        // The twin recovers the same address with raw ecrecover, but OZ ECDSA rejects high-s.
        assertEq(ecrecover(digest, flippedV, r, highS), owner);
        _expectInvalidSignature(owner);
        vault.commitBatch(b, abi.encodePacked(r, highS, flippedV), "");
    }

    function test_commitBatch_revertsOnBadV() public {
        AuditVaultV3.Batch memory b = _next(agentId);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(ownerKey, vault.hashBatch(b));
        uint8[4] memory badVs = [uint8(0), 1, 29, v == 27 ? uint8(28) : uint8(27)];
        for (uint256 i = 0; i < badVs.length; ++i) {
            _expectInvalidSignature(owner);
            vault.commitBatch(b, abi.encodePacked(r, s, badVs[i]), "");
        }
    }

    // ─── Forgery (§8.1) ───

    function test_commitBatch_revertsIfSignedByStranger() public {
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(strangerKey, b);
        _expectInvalidSignature(owner);
        vm.prank(stranger);
        vault.commitBatch(b, sig, "");
    }

    function test_commitBatch_revertsOnWrongRegistry() public {
        AuditVaultV3.Batch memory b = _next(agentId);
        b.identityRegistry = CANONICAL_REGISTRY;
        bytes memory sig = _sign(ownerKey, b);
        vm.expectRevert(abi.encodeWithSelector(AuditVaultV3.WrongRegistry.selector, CANONICAL_REGISTRY));
        vault.commitBatch(b, sig, "");
    }

    function test_commitBatch_revertsIfAgentIdTamperedToKnownAgent() public {
        vm.prank(newOwner);
        uint256 other = registry.register();
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory sig = _sign(ownerKey, b);
        b.agentId = other;
        _expectInvalidSignature(newOwner);
        vault.commitBatch(b, sig, "");
    }

