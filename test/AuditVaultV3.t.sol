    // ─── verifyInclusion (§5.5) ───

    /// @dev Commits the fixture tree of size n (leaves bytes([i])*32) as a rootFormat-0 batch.
    function _commitTree(string memory json, uint256 n) internal returns (AuditVaultV3.Batch memory b) {
        b = _next(agentId);
        b.root = vm.parseJsonBytes32(json, string.concat(".trees[", vm.toString(n - 1), "].root"));
        b.leafCount = uint64(n);
        _commit(ownerKey, b);
    }

    function _proof(string memory json, uint256 n, uint256 i) internal pure returns (bytes32[] memory) {
        if (n == 1) return new bytes32[](0);
        return vm.parseJsonBytes32Array(
            json, string.concat(".trees[", vm.toString(n - 1), "].proofs[", vm.toString(i), "]")
        );
    }

    /// @dev RFC 6962 audit-path length of leaf `i` in a tree of `n` leaves.
    function _pathLen(uint256 i, uint256 n) internal pure returns (uint256) {
        if (n == 1) return 0;
        uint256 k = 1;
        while (k * 2 < n) k *= 2;
        return 1 + (i < k ? _pathLen(i, k) : _pathLen(i - k, n - k));
    }

    function _leaf(uint256 i) internal pure returns (bytes32) {
        return bytes32(uint256(uint8(i)) * 0x0101010101010101010101010101010101010101010101010101010101010101);
    }

    function test_verifyInclusion_allLeavesAllSizes() public {
        string memory json = vm.readFile(RFC6962);
        for (uint256 n = 1; n <= 17; ++n) {
            AuditVaultV3.Batch memory b = _commitTree(json, n);
            for (uint256 i = 0; i < n; ++i) {
                bytes32 leafData =
                    vm.parseJsonBytes32(json, string.concat(".trees[", vm.toString(n - 1), "].leaves[", vm.toString(i), "]"));
                assertEq(leafData, _leaf(i + 1));
                assertTrue(vault.verifyInclusion(b, uint64(i), leafData, _proof(json, n, i)));
            }
        }
    }

    function test_verifyInclusion_largeTreeSamples() public {
        string memory json = vm.readFile(RFC6962);
        AuditVaultV3.Batch memory b = _next(agentId);
        b.root = vm.parseJsonBytes32(json, ".large.root");
        b.leafCount = 1000;
        _commit(ownerKey, b);
        uint256 k = 0;
        bool sawShort;
        for (; vm.keyExistsJson(json, string.concat(".large.samples[", vm.toString(k), "]")); ++k) {
            string memory p = string.concat(".large.samples[", vm.toString(k), "]");
            uint256 idx = vm.parseJsonUint(json, string.concat(p, ".index"));
            bytes32 leafData = vm.parseJsonBytes32(json, string.concat(p, ".leaf"));
            assertEq(leafData, sha256(abi.encodePacked(uint32(idx))));
            bytes32[] memory proof = vm.parseJsonBytes32Array(json, string.concat(p, ".proof"));
            // Not constant when n is not a power of two: leaves 992..999 have 8 elements, the rest 10.
            assertEq(proof.length, _pathLen(idx, 1000));
            if (proof.length == 8) sawShort = true;
            assertTrue(vault.verifyInclusion(b, uint64(idx), leafData, proof));
            assertFalse(vault.verifyInclusion(b, uint64(idx ^ 1), leafData, proof));
        }
        assertEq(k, 14);
        assertTrue(sawShort);
        assertEq(_pathLen(991, 1000), 10);
        assertEq(_pathLen(992, 1000), 8);
    }

