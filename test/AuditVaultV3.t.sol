    function test_verifyInclusion_falseOnTruncatedProof() public {
        string memory json = vm.readFile(RFC6962);
        for (uint256 n = 2; n <= 17; ++n) {
            AuditVaultV3.Batch memory b = _commitTree(json, n);
            for (uint256 i = 0; i < n; ++i) {
                bytes32[] memory proof = _proof(json, n, i);
                bytes32[] memory dropLast = new bytes32[](proof.length - 1);
                bytes32[] memory dropFirst = new bytes32[](proof.length - 1);
                for (uint256 k = 0; k + 1 < proof.length; ++k) {
                    dropLast[k] = proof[k];
                    dropFirst[k] = proof[k + 1];
                }
                assertFalse(vault.verifyInclusion(b, uint64(i), _leaf(i + 1), dropLast));
                assertFalse(vault.verifyInclusion(b, uint64(i), _leaf(i + 1), dropFirst));
                assertFalse(vault.verifyInclusion(b, uint64(i), _leaf(i + 1), new bytes32[](0)));
            }
        }
    }

    function test_verifyInclusion_falseOnExtraProofElement() public {
        string memory json = vm.readFile(RFC6962);
        for (uint256 n = 1; n <= 17; ++n) {
            AuditVaultV3.Batch memory b = _commitTree(json, n);
            for (uint256 i = 0; i < n; ++i) {
                bytes32[] memory proof = _proof(json, n, i);
                bytes32[] memory extra = new bytes32[](proof.length + 1);
                for (uint256 k = 0; k < proof.length; ++k) {
                    extra[k] = proof[k];
                }
                extra[proof.length] = b.root;
                assertFalse(vault.verifyInclusion(b, uint64(i), _leaf(i + 1), extra));
            }
        }
    }

    /// @notice KI-2: no internal node (and no leaf hash) passes as leaf data, with its path to the root,
    ///         at any index, against any committed leafCount 1…n over the same root.
    function test_verifyInclusion_falseForInternalNodeAsLeaf() public {
        string memory json = vm.readFile(RFC6962);
        for (uint256 n = 2; n <= 17; ++n) {
            string memory t = string.concat(".trees[", vm.toString(n - 1), "]");
            bytes32 root = vm.parseJsonBytes32(json, string.concat(t, ".root"));
            AuditVaultV3.Batch[] memory claims = new AuditVaultV3.Batch[](n);
            for (uint256 m = 1; m <= n; ++m) {
                AuditVaultV3.Batch memory b = _next(agentId);
                b.root = root;
                b.leafCount = uint64(m); // the signer may claim any leafCount; the contract cannot check it
                _commit(ownerKey, b);
                claims[m - 1] = b;
            }
            for (uint256 k = 0; k + 1 < n; ++k) {
                string memory node = string.concat(t, ".nodes[", vm.toString(k), "]");
                bytes32 nodeHash = vm.parseJsonBytes32(json, string.concat(node, ".hash"));
                bytes32[] memory path = (k == 0)
                    ? new bytes32[](0) // the root node has an empty path
                    : vm.parseJsonBytes32Array(json, string.concat(node, ".path"));
                for (uint256 m = 1; m <= n; ++m) {
                    for (uint256 idx = 0; idx < m; ++idx) {
                        assertFalse(vault.verifyInclusion(claims[m - 1], uint64(idx), nodeHash, path));
                    }
                }
            }
            // A leaf *hash* presented as leaf data is hashed again and fails too.
            for (uint256 i = 0; i < n; ++i) {
                bytes32 leafHash = sha256(abi.encodePacked(bytes1(0x00), _leaf(i + 1)));
                assertFalse(vault.verifyInclusion(claims[n - 1], uint64(i), leafHash, _proof(json, n, i)));
                assertTrue(vault.verifyInclusion(claims[n - 1], uint64(i), _leaf(i + 1), _proof(json, n, i)));
            }
        }
    }

    // ─── ERC-8021 builder-code suffix (§10) ───

    function _commitWithSuffix(bytes memory suffix)
        internal
        returns (bytes32 ret, Vm.Log[] memory logs, bytes32 rec)
    {
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes memory data = abi.encodeCall(vault.commitBatch, (b, _sign(ownerKey, b), "ipfs://batch"));
        vm.recordLogs();
        (bool ok, bytes memory out) = address(vault).call(bytes.concat(data, suffix));
        assertTrue(ok);
        logs = vm.getRecordedLogs();
        ret = abi.decode(out, (bytes32));
        (address signer, uint64 bn, uint32 ts) = vault.batchRecord(ret);
        rec = keccak256(abi.encode(vault.nextSeq(agentId), vault.batchHashAt(agentId, 0), signer, bn, ts));
    }

    function _assertSuffixIgnored(bytes memory suffix) internal {
        uint256 snap = vm.snapshotState();
        (bytes32 r1, Vm.Log[] memory l1, bytes32 s1) = _commitWithSuffix("");
        vm.revertToState(snap);
        (bytes32 r2, Vm.Log[] memory l2, bytes32 s2) = _commitWithSuffix(suffix);
        assertEq(r1, r2);
        assertEq(s1, s2);
        assertEq(l1.length, 1);
        assertEq(l2.length, 1);
        assertEq(l1[0].topics, l2[0].topics);
        assertEq(l1[0].data, l2[0].data);
    }

    function test_commitBatch_builderCodeSuffixIgnored() public {
        // ERC-8021 test vector suffix (schema 0, codes "baseapp"): codes ‖ codesLength ‖ schemaId ‖ ercMarker
        _assertSuffixIgnored(hex"62617365617070" hex"07" hex"00" hex"80218021802180218021802180218021");
    }

    function test_commitBatch_suffixLookingLikeAbiTail() public {
        // Trailing words that look like another ABI-encoded dynamic string, plus a fake batch, then the marker.
        bytes memory fake = abi.encode(uint256(0x20), uint256(5), bytes32("evil!"), _batch(agentId, 7, bytes32(0)));
        _assertSuffixIgnored(bytes.concat(fake, hex"00", hex"80218021802180218021802180218021"));
    }

    // ─── EIP-712 (§3) ───

    function test_batchTypehash_matchesDoc() public view {
        assertEq(vault.BATCH_TYPEHASH(), BATCH_TYPEHASH);
        assertEq(
            keccak256(
                "Batch(address identityRegistry,uint256 agentId,uint64 seq,bytes32 prevBatchHash,bytes32 root,uint64 leafCount,uint8 rootFormat,bytes32 metaHash)"
            ),
            BATCH_TYPEHASH
        );
    }

    function test_eip712Domain_values() public view {
        (
            bytes1 fields,
            string memory name,
            string memory version,
            uint256 chainId,
            address verifyingContract,
            bytes32 salt,
            uint256[] memory extensions
        ) = vault.eip712Domain();
        assertEq(uint8(fields), 0x0f);
        assertEq(name, "AgentAudit AuditVault");
        assertEq(version, "3");
        assertEq(keccak256(bytes(name)), NAME_HASH);
        assertEq(keccak256(bytes(version)), VERSION_HASH);
        assertEq(chainId, block.chainid);
        assertEq(verifyingContract, address(vault));
        assertEq(salt, bytes32(0));
        assertEq(extensions.length, 0);
    }

    function test_hashBatch_matchesManualDigest(
        uint256 id,
        uint64 seq,
        bytes32 prev,
        bytes32 root,
        uint64 leafCount,
        uint8 rootFormat,
        bytes32 metaHash
    ) public view {
        AuditVaultV3.Batch memory b = AuditVaultV3.Batch(address(registry), id, seq, prev, root, leafCount, rootFormat, metaHash);
        assertEq(vault.hashBatch(b), _digest(b, block.chainid, address(vault)));
    }

    function test_domainSeparator_recomputedAfterChainIdChange() public {
        AuditVaultV3.Batch memory b = _next(agentId);
        bytes32 before = vault.hashBatch(b);
        assertEq(before, _digest(b, 31337, address(vault)));
        vm.chainId(42220);
        bytes32 afterFork = vault.hashBatch(b);
        assertTrue(afterFork != before);
        assertEq(afterFork, _digest(b, 42220, address(vault)));
        (,,, uint256 chainId,,,) = vault.eip712Domain();
        assertEq(chainId, 42220);
        // A batch signed for the new chain id commits there.
        _commit(ownerKey, b);
    }

    /// @notice eip712.json was produced by ethers (TypedDataEncoder + SigningKey), not by this code.
    function test_hashBatch_matchesFixture() public {
        string memory json = vm.readFile(EIP712_FIXTURE);
        address verifyingContract = vm.parseJsonAddress(json, ".domain.verifyingContract");
        address reg = vm.parseJsonAddress(json, ".batch.identityRegistry");
        address signerAddr = vm.parseJsonAddress(json, ".signer.address");
        assertEq(reg, CANONICAL_REGISTRY);
        assertEq(vm.parseJsonBytes32(json, ".typehashes.batch"), BATCH_TYPEHASH);
        assertEq(vm.parseJsonBytes32(json, ".typehashes.domain"), DOMAIN_TYPEHASH);
        assertEq(vm.parseJsonBytes32(json, ".typehashes.name_hash"), NAME_HASH);
        assertEq(vm.parseJsonBytes32(json, ".typehashes.version_hash"), VERSION_HASH);
        assertEq(vm.addr(vm.parseJsonUint(json, ".signer.privateKey")), signerAddr);

        vm.chainId(vm.parseJsonUint(json, ".domain.chainId"));
        deployCodeTo("MockERC8004IdentityRegistry.sol:MockERC8004IdentityRegistry", reg);
        deployCodeTo("AuditVaultV3.sol:AuditVaultV3", abi.encode(reg), verifyingContract);
        AuditVaultV3 fv = AuditVaultV3(verifyingContract);
        vm.prank(signerAddr);
        uint256 id = MockERC8004IdentityRegistry(reg).register();

        AuditVaultV3.Batch memory b = AuditVaultV3.Batch({
            identityRegistry: reg,
            agentId: vm.parseJsonUint(json, ".batch.agentId"),
            seq: uint64(vm.parseJsonUint(json, ".batch.seq")),
            prevBatchHash: vm.parseJsonBytes32(json, ".batch.prevBatchHash"),
            root: vm.parseJsonBytes32(json, ".batch.root"),
            leafCount: uint64(vm.parseJsonUint(json, ".batch.leafCount")),
            rootFormat: uint8(vm.parseJsonUint(json, ".batch.rootFormat")),
            metaHash: vm.parseJsonBytes32(json, ".batch.metaHash")
        });
        assertEq(b.agentId, id);
        assertEq(b.root, vm.parseJsonBytes32(vm.readFile(RFC6962), ".trees[2].root"));
        assertEq(b.metaHash, sha256(bytes(vm.parseJsonString(json, ".batch.metaHash_preimage_utf8"))));

        bytes32 ds = vm.parseJsonBytes32(json, ".domainSeparator");
        bytes32 sh = vm.parseJsonBytes32(json, ".structHash");
        bytes32 bh = vm.parseJsonBytes32(json, ".batchHash");
        assertEq(keccak256(abi.encode(DOMAIN_TYPEHASH, NAME_HASH, VERSION_HASH, block.chainid, verifyingContract)), ds);
        assertEq(_structHash(b), sh);
        assertEq(keccak256(abi.encodePacked(hex"1901", ds, sh)), bh);
        assertEq(fv.hashBatch(b), bh);

        bytes memory sig = vm.parseJsonBytes(json, ".signature.serialized");
        assertEq(sig.length, 65);
        bytes32 h = fv.commitBatch(b, sig, "");
        assertEq(h, bh);
        (address recorded,,) = fv.batchRecord(bh);
        assertEq(recorded, signerAddr);
    }

    // ─── No admin, no fallback (§7, §10) ───

    function test_noOwnerOrPauseSelectors() public {
        bytes4[12] memory forbidden = [
            bytes4(keccak256("owner()")),
            bytes4(keccak256("pause()")),
            bytes4(keccak256("unpause()")),
            bytes4(keccak256("paused()")),
            bytes4(keccak256("transferOwnership(address)")),
            bytes4(keccak256("renounceOwnership()")),
            bytes4(keccak256("upgradeTo(address)")),
            bytes4(keccak256("upgradeToAndCall(address,bytes)")),
            bytes4(keccak256("proxiableUUID()")),
            bytes4(keccak256("commitHighRiskEvent(address,bytes32,string)")),
            bytes4(keccak256("commitBatch(address,bytes32,string,uint256,uint8)")),
            bytes4(keccak256("registerAgent(address,string,string,string)"))
        ];
        bytes memory code = address(vault).code;
        // Positive control: the dispatcher's PUSH4 for real selectors is found by the same scan.
        assertTrue(_contains(code, abi.encodePacked(hex"63", AuditVaultV3.commitBatch.selector)));
        assertTrue(_contains(code, abi.encodePacked(hex"63", AuditVaultV3.verifyInclusion.selector)));
        for (uint256 i = 0; i < forbidden.length; ++i) {
            assertFalse(_contains(code, abi.encodePacked(hex"63", forbidden[i])));
            (bool ok,) = address(vault).call(abi.encodePacked(forbidden[i], new bytes(96)));
            assertFalse(ok);
        }
    }

    function test_noFallbackOrReceive() public {
        vm.deal(address(this), 1 ether);
        (bool ok,) = address(vault).call("");
        assertFalse(ok);
        (ok,) = address(vault).call{value: 1 wei}("");
        assertFalse(ok);
        (ok,) = address(vault).call(hex"deadbeef");
        assertFalse(ok);
    }
